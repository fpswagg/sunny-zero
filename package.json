{
  "name": "sunny-zero",
  "version": "0.1.0",
  "description": "Sunny Zero: a self-hosted agent system on the Claude Agent SDK. Sunny creates, runs and manages your AI agents, from Telegram, a web app or the terminal.",
  "private": true,
  "author": "fpswagg",
  "type": "module",
  "bin": {
    "sunny": "bin/sunny"
  },
  "scripts": {
    "sunny": "tsx src/cli.ts",
    "serve": "tsx src/cli.ts serve",
    "dev": "tsx watch src/cli.ts serve",
    "chat": "tsx src/cli.ts chat",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "pm2:start": "pm2 startOrReload ecosystem.config.cjs --update-env && pm2 save",
    "pm2:stop": "pm2 stop sunny && pm2 save",
    "pm2:logs": "pm2 logs sunny",
    "db:up": "docker compose up -d"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@12.8.1",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.8.1",
      "onFail": "download"
    }
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.287",
    "@fastify/formbody": "^9.0.0",
    "@fastify/websocket": "^11.3.1",
    "@grammyjs/auto-retry": "^2.0.2",
    "@huggingface/transformers": "^4.3.0",
    "croner": "^10.0.1",
    "fastify": "^5.12.5",
    "grammy": "^1.46.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9",
    "sharp": "^0.35.5",
    "telegram": "^2.26.22",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fpswagg/sunny-zero.git"
  }
}
