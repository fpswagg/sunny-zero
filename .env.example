# ─── Sunny Zero settings ───────────────────────────────────────────────
# Copy to .env and edit. Only SUNNY_DATABASE_URL is required; everything else has a default.
# Secrets (Telegram tokens, API keys) never go here: Sunny asks for them on one-time secure pages
# and stores them encrypted in the database.

# Postgres for everything Sunny remembers. `docker compose up -d` starts one matching this URL.
SUNNY_DATABASE_URL=postgresql://sunny:sunny@127.0.0.1:5432/sunny

# The public HTTPS address of this server (see docs/HTTPS.md). Needed for the secure setup pages,
# OAuth sign-ins and the Telegram apps. Leave it unset until HTTPS works.
# SUNNY_PUBLIC_URL=https://sunny.example.com

# Where the daemon listens. Keep 127.0.0.1 behind a reverse proxy on the same machine.
SUNNY_PORT=3210
SUNNY_BIND=127.0.0.1

# Your timezone, for scheduled (cron) agents.
SUNNY_TIMEZONE=UTC

# Models. Aliases (opus, sonnet, haiku) follow the latest version; full ids and "provider:model" also work.
SUNNY_MODEL=opus
SUNNY_AGENT_DEFAULT_MODEL=sonnet

# Voice messages and calls run on the provider's light model (Haiku on Claude). false = the agent's own model.
SUNNY_VOICE_LIGHT=true

# Long conversations are summarised past this many tokens, so each reply stays cheap. 0 = Claude Code's default.
SUNNY_COMPACT_TOKENS=200000

# Runs use your Claude subscription (the `claude` login on this machine). ANTHROPIC_API_KEY is
# removed from the agents' environment unless this is true.
SUNNY_USE_API_KEY=false

# With two Claude accounts, the one agents use first (id, label or e-mail). Empty: the first one.
# SUNNY_CLAUDE_MAIN=

# Minutes before an unanswered approval is denied / a secure link expires.
SUNNY_APPROVAL_TIMEOUT_MIN=10
SUNNY_AUTH_LINK_TTL_MIN=15

# Encryption key for stored credentials (base64, 32 bytes). Unset: data/master.key is created. Back it up.
# SUNNY_MASTER_KEY=

# Files sent in chat are kept this many days. Voice is transcribed by ElevenLabs or OpenAI when
# their keys are connected, else locally with Whisper (downloaded once into data/models).
# SUNNY_INBOX_DAYS=30
# SUNNY_WHISPER_MODEL=onnx-community/whisper-small
# SUNNY_WHISPER_LANGUAGES=en,fr
# SUNNY_TRANSCRIBE_MAX_MIN=15

# Shared secret other apps send (header x-sunny-secret) to POST events to /events/<source>.
# SUNNY_EVENTS_SECRET=

# SUNNY_DATA_DIR=./data
# SUNNY_AGENTS_DIR=./agents
LOG_LEVEL=info
